# ============================================================
# MotoPatio — variables de entorno (plantilla)
# Copia este archivo a `.env` y reemplaza los placeholders.
# El `.env` real NUNCA se commitea.
# ============================================================

# --- Base de datos (MySQL) ---
DATABASE_URL="mysql://usuario:password@localhost:3306/motopatio"

# --- NextAuth ---
# NEXTAUTH_SECRET: generar con `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="reemplazar-con-token-aleatorio-largo"

# URL publica del app (usada por scripts y frontend)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxx"

# --- Resend (emails transaccionales) ---
# https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Cloudinary (imagenes) ---
# IMPORTANTE: la API Key debe tener el rol "Admin" asignado en Cloudinary
# (Settings -> Access Keys -> Assign Roles), de lo contrario los uploads
# devuelven 403.
CLOUDINARY_CLOUD_NAME="dxxxxxxxx"
CLOUDINARY_API_KEY="xxxxxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- PayPhone Cajita de Pagos ---
# https://developer.payphone.app -> app MotoPatio Web -> Credenciales
PAYPHONE_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYPHONE_STORE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Crons (autenticacion Bearer) ---
# Generar cada uno con `openssl rand -hex 32`. Mantenerlos separados
# para poder rotar uno sin afectar al otro.
RECONCILIATOR_SECRET="reemplazar-con-token-aleatorio-largo"
CRON_SECRET="reemplazar-con-token-aleatorio-largo"

# --- Google Analytics (opcional) ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- Stripe (instalado pero NO en uso; pueden quedar vacios) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
